# Copy to .env and fill in. Anchora reads these from the environment; the
# variable names are configurable in config.yaml. No API keys are needed: the
# agent sidecar serves a public Hugging Face checkpoint locally.

# Required only when async.enabled is true. These match docker-compose.yml.
DATABASE_URL=postgres://anchora:anchora@localhost:5432/anchora?sslmode=disable
REDIS_URL=redis://localhost:6379/0

# Agent sidecar (agent/main.py). See docs/models.md for the model matrix and
# docs/performance.md for what each knob does.
# MODEL_NAME=mlx-community/Qwen3-8B-4bit   # any Qwen3 checkpoint; see docs/models.md
# BACKEND=auto                             # auto | mlx | transformers
# MAX_NEW_TOKENS=256
# BATCH_SIZE=16
# ENABLE_THINKING=false
# TEMPERATURE=0
