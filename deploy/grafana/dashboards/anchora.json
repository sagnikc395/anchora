    {
      "id": 42,
      "type": "timeseries",
      "title": "Nondeterminism",
      "description": "Replays whose code no longer matches recorded history. Should be flat zero; any rise is a bad deploy.",
      "gridPos": {
        "x": 16,
        "y": 28,
        "w": 8,
        "h": 6
      },
      "datasource": {
        "type": "prometheus",
