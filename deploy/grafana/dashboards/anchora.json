      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 30,
      "type": "timeseries",
      "title": "Step latency p99 by step",
      "description": "Includes retry backoff, so a retrying step shows up here first.",
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 8,
        "h": 8
