    {
      "id": 41,
      "type": "timeseries",
      "title": "Epoch fencing",
      "description": "Executions that lost a race to a newer epoch. Proves two executors never both commit.",
      "gridPos": {
        "x": 8,
        "y": 28,
        "w": 8,
        "h": 6
      },
      "datasource": {
        "type": "prometheus",
