          },
          "expr": "sum by (status) (increase(anchora_steps_total[1h]))",
          "refId": "A",
          "legendFormat": "{{status}}"
        }
      ]
    },
    {
      "id": 9,
      "type": "bargauge",
      "title": "Responses by code (1h)",
